# Cleans out deleted branches
alias clean_branches="git branch -r | awk '{print $1}' | egrep -v -f /dev/fd/0 <(git branch -vv | grep origin) | awk '{print $1}' | xargs git branch -d"

# Adds a spacer to the dock
alias addspacer="defaults write com.apple.dock persistent-apps -array-add '{tile-data={}; tile-type=\"small-spacer-tile\";}' && killall Dock"

# Quick access to work repositories
devrepo() { 
  cd ~/Projects/ifit/$1
	code . 
}

openrepo() { 
	cd ~/Projects/ifit/$1 
}

# Start code review. Usage: review {repo_name} {branch_name}
review() {
  openrepo $1
	git fetch 
  git checkout $2
	git pull
	code .
}

alias gs="git status"

alias webserver="python -m SimpleHTTPServer 8000"

pull_monolith_data() {
  docker exec monolith_mongo mongodump --host galactica.ifit-dev.com --port $1 --ssl --sslCAFile /root/.ssh/mongodb.ca.cert.pem --sslPEMKeyFile /root/.ssh/mongodb.viper-user.key-and-cert.pem --out=/backup/$1
}

restore_monolith_data() {
	docker exec monolith_mongo mongorestore --drop --noIndexRestore /backup/$1
}

alias or="openrepo"

alias docker-compose="docker compose"
